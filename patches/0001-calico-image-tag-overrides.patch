diff --git a/pkg/components/tag_overrides.go b/pkg/components/tag_overrides.go
new file mode 100644
index 0000000..24e9262
--- /dev/null
+++ b/pkg/components/tag_overrides.go
@@ -0,0 +1,84 @@
+package components
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"regexp"
+	"strings"
+)
+
+const CalicoImageTagOverridesEnv = "CALICO_IMAGE_TAG_OVERRIDES"
+
+// OCI/Docker tag grammar: an ASCII word character followed by up to 127
+// ASCII word characters, periods, or hyphens.
+var imageTagPattern = regexp.MustCompile(`^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$`)
+
+// Written once before controllers start; reconciliation only reads this map.
+var calicoImageTagOverrides map[string]string
+
+// LoadCalicoImageTagOverrides validates the environment and installs exact tags
+// without modifying component versions or the logical Calico release.
+func LoadCalicoImageTagOverrides() (map[string]string, error) {
+	value, present := os.LookupEnv(CalicoImageTagOverridesEnv)
+	tags, err := parseCalicoImageTagOverrides(value, present)
+	if err != nil {
+		return nil, fmt.Errorf("%s: %w", CalicoImageTagOverridesEnv, err)
+	}
+	calicoImageTagOverrides = tags
+	// Do not expose the map used by concurrent reconcilers to mutation.
+	result := make(map[string]string, len(tags))
+	for component, tag := range tags {
+		result[component] = tag
+	}
+	return result, nil
+}
+
+func parseCalicoImageTagOverrides(value string, present bool) (map[string]string, error) {
+	tags := map[string]string{}
+	if !present {
+		return tags, nil
+	}
+	decoder := json.NewDecoder(strings.NewReader(value))
+	token, err := decoder.Token()
+	if err != nil {
+		return nil, fmt.Errorf("expected a JSON object: %w", err)
+	}
+	if token != json.Delim('{') {
+		return nil, fmt.Errorf("expected a JSON object")
+	}
+	known := map[string]bool{}
+	for _, component := range CalicoImages {
+		known[component.Image] = true
+	}
+	for decoder.More() {
+		token, err = decoder.Token()
+		if err != nil {
+			return nil, fmt.Errorf("invalid component key: %w", err)
+		}
+		key, ok := token.(string)
+		if !ok || !known[key] {
+			return nil, fmt.Errorf("unknown Calico component %q", token)
+		}
+		if _, duplicate := tags[key]; duplicate {
+			return nil, fmt.Errorf("duplicate component %q", key)
+		}
+		var value any
+		if err := decoder.Decode(&value); err != nil {
+			return nil, fmt.Errorf("invalid tag for %q: %w", key, err)
+		}
+		tag, ok := value.(string)
+		if !ok || !imageTagPattern.MatchString(tag) {
+			return nil, fmt.Errorf("invalid tag for %q: expected a complete image tag matching [A-Za-z0-9_][A-Za-z0-9_.-]{0,127}", key)
+		}
+		tags[key] = tag
+	}
+	if _, err := decoder.Token(); err != nil {
+		return nil, fmt.Errorf("invalid JSON object: %w", err)
+	}
+	if _, err := decoder.Token(); err != io.EOF {
+		return nil, fmt.Errorf("unexpected data after JSON object")
+	}
+	return tags, nil
+}
