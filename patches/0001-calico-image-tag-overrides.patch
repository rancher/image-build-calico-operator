@@ -0,0 +1,95 @@
+package components
+
+import (
+	"strings"
+	"testing"
+
+	operator "github.com/tigera/operator/api/v1"
+)
+
+func TestCalicoTagOverrideConfiguration(t *testing.T) {
+	for _, value := range []string{
+		"", " ", "null", "[]", `"tag"`, "1", "true", "{",
+		`{"node":null}`, `{"node":1}`, `{"node":true}`, `{"node":[]}`, `{"node":{}}`,
+		`{"node":""}`, `{"node":"-bad"}`, `{"node":".bad"}`, `{"node":"a b"}`,
+		`{"node":"registry/repo:tag"}`, `{"node":"sha256:abc"}`, `{"node":"é"}`,
+		`{"node":"` + strings.Repeat("a", 129) + `"}`,
+		`{"typha":"v1"}`, `{"hardened-calico-node":"v1"}`, `{"operator":"v1"}`,
+		`{"node":"v1","node":"v2"}`, `{"node":"v1","\u006eode":"v2"}`,
+		`{} {}`, `{} trailing`, `{"node":"v1",}`,
+	} {
+		t.Run(value, func(t *testing.T) {
+			if _, err := parseCalicoImageTagOverrides(value, true); err == nil {
+				t.Fatalf("accepted invalid configuration %q", value)
+			}
+		})
+	}
+	for _, value := range []string{"{}", " \n{} ", `{"node":"_tag-1.2"}`, `{"node":"` + strings.Repeat("a", 128) + `"}`} {
+		if _, err := parseCalicoImageTagOverrides(value, true); err != nil {
+			t.Fatalf("rejected valid configuration %q: %v", value, err)
+		}
+	}
+	if tags, err := parseCalicoImageTagOverrides("", false); err != nil || len(tags) != 0 {
+		t.Fatalf("absent variable: %v, %v", tags, err)
+	}
+}
+
+func TestCalicoTagOverrideReferences(t *testing.T) {
+	old := calicoImageTagOverrides
+	t.Cleanup(func() { calicoImageTagOverrides = old })
+	t.Setenv(CalicoImageTagOverridesEnv, `{"calico":"v3.33.0-build20261022","node":"v3.33.0-build20261023","third-party-cni-plugins":"v3.33.0-build20261024"}`)
+	tags, err := LoadCalicoImageTagOverrides()
+	if err != nil {
+		t.Fatal(err)
+	}
+	tags["node"] = "must-not-mutate-internal-map"
+	for _, c := range CalicoImages {
+		tag := c.Version
+		if override, ok := calicoImageTagOverrides[c.Image]; ok {
+			tag = override
+		}
+		for _, registry := range []string{"registry.suse.com", "mirror.example:5000"} {
+			got, err := GetReference(c, registry, "rancher", "hardened-calico-", nil)
+			want := registry + "/rancher/hardened-calico-" + c.Image + ":" + tag
+			if err != nil || got != want {
+				t.Fatalf("got %q, %v; want %q", got, err, want)
+			}
+		}
+	}
+	for _, c := range append(append([]Component{}, EnterpriseImages...), ComponentOperatorInit) {
+		got, err := GetReference(c, "mirror", "images", "", nil)
+		if want := "mirror/images/" + c.Image + ":" + c.Version; err != nil || got != want {
+			t.Fatalf("non-Calico component changed: %q, %v; want %q", got, err, want)
+		}
+	}
+	digest := "sha256:" + strings.Repeat("a", 64)
+	is := &operator.ImageSet{Spec: operator.ImageSetSpec{Images: []operator.Image{{Image: "calico/node", Digest: digest}}}}
+	if got, err := GetReference(ComponentCalicoNode, "mirror", "images", "prefix-", is); err != nil || got != "mirror/images/prefix-node@"+digest {
+		t.Fatalf("ImageSet precedence: %q, %v", got, err)
+	}
+	if _, err := GetReference(ComponentCalico, "", "", "", is); err == nil {
+		t.Fatal("missing ImageSet entry fell back to tag")
+	}
+	if CalicoRelease != "v3.33.0" || ComponentCalicoNode.Version != "v3.33.0" {
+		t.Fatal("compiled release identity changed")
+	}
+	for _, value := range []string{"{}", ""} {
+		if value == "" {
+			t.Setenv(CalicoImageTagOverridesEnv, "")
+			if _, err := LoadCalicoImageTagOverrides(); err == nil || !strings.Contains(err.Error(), CalicoImageTagOverridesEnv) {
+				t.Fatalf("startup error lacks environment context: %v", err)
+			}
+			continue
+		}
+		t.Setenv(CalicoImageTagOverridesEnv, value)
+		if _, err := LoadCalicoImageTagOverrides(); err != nil {
+			t.Fatal(err)
+		}
+		for _, prefix := range []string{"", "hardened-calico-"} {
+			got, err := GetReference(ComponentCalicoNode, "mirror", "images", prefix, nil)
+			if want := "mirror/images/" + prefix + "node:v3.33.0"; err != nil || got != want {
+				t.Fatalf("no-op changed reference: %q, %v", got, err)
+			}
+		}
+	}
+}
