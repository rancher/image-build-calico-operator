diff --git a/test/tag_overrides.go b/test/tag_overrides.go
new file mode 100644
index 0000000..8b56aa0
--- /dev/null
+++ b/test/tag_overrides.go
@@ -0,0 +1,23 @@
+package test
+
+import "github.com/tigera/operator/pkg/components"
+
+// SetCalicoImageTagOverrides restores both the environment and resolver state
+// after a test. Tests using this startup-only setting must not run in parallel.
+func SetCalicoImageTagOverrides(t interface {
+	Helper()
+	Cleanup(func())
+	Setenv(string, string)
+	Fatalf(string, ...any)
+}, value string) {
+	t.Helper()
+	t.Cleanup(func() {
+		if _, err := components.LoadCalicoImageTagOverrides(); err != nil {
+			t.Fatalf("restoring image tags: %v", err)
+		}
+	})
+	t.Setenv(components.CalicoImageTagOverridesEnv, value)
+	if _, err := components.LoadCalicoImageTagOverrides(); err != nil {
+		t.Fatalf("loading image tags: %v", err)
+	}
+}
